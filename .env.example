# Postgres. In production this is the Coolify-managed Postgres reached by its
# internal hostname -- never a public port.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# The MundaManager Supabase project, used ONLY as an identity provider.
# No Supabase client runs on the server and no Supabase table is read.
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
